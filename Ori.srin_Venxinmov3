        function TabObj:AddSearchableList(text, list, callback)
            local frame = Instance.new("Frame", scrollingFrame)
            frame.Size = UDim2.new(1, 0, 0, 36)
            frame.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
            frame.ClipsDescendants = true
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
            local searchBox = Instance.new("TextBox", frame)
            searchBox.Size = UDim2.new(1, -45, 0, 28)
            searchBox.Position = UDim2.new(0, 8, 0, 4)
            searchBox.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            searchBox.Text = ""
            searchBox.PlaceholderText = text or "Search items..."
            searchBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            searchBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
            searchBox.TextSize = 12
            searchBox.Font = Enum.Font.Gotham
            Instance.new("UICorner", searchBox).CornerRadius = UDim.new(0, 4)
            local arrowBtn = Instance.new("TextButton", frame)
            arrowBtn.Size = UDim2.new(0, 30, 0, 28)
            arrowBtn.Position = UDim2.new(1, -38, 0, 4)
            arrowBtn.BackgroundTransparency = 1
            arrowBtn.Text = "▼"
            arrowBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            arrowBtn.TextSize = 10
            arrowBtn.Font = Enum.Font.GothamBold
            local listHolder = Instance.new("ScrollingFrame", frame)
            listHolder.Size = UDim2.new(1, -16, 0, 0)
            listHolder.Position = UDim2.new(0, 8, 0, 36)
            listHolder.BackgroundTransparency = 1
            listHolder.ScrollBarThickness = 2
            local listLayout = Instance.new("UIListLayout", listHolder)
            listLayout.Padding = UDim.new(0, 4)
            local open = false
            local normalHeight = 36
            local function updateItems(filter)
                for _, child in ipairs(listHolder:GetChildren()) do
                    if child:IsA("TextButton") then
                        child:Destroy()
                    end
                end
                local count = 0
                for _, v in ipairs(list or {}) do
                    local strVal = tostring(v)
                    if filter == "" or string.find(string.lower(strVal), string.lower(filter)) then
                        count = count + 1
                        local itemBtn = Instance.new("TextButton", listHolder)
                        itemBtn.Size = UDim2.new(1, 0, 0, 26)
                        itemBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                        itemBtn.Text = strVal
                        itemBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
                        itemBtn.TextSize = 11
                        itemBtn.Font = Enum.Font.Gotham
                        Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 4)
                        itemBtn.MouseButton1Click:Connect(function()
                            searchBox.Text = strVal
                            open = false
                            arrowBtn.Text = "▼"
                            TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, normalHeight)}):Play()
                            TweenService:Create(listHolder, TweenInfo.new(0.2), {Size = UDim2.new(1, -16, 0, 0)}):Play()
                            pcall(function() callback(strVal) end)
                        end)
                    end
                end
                listHolder.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
                if open then
                    local contentH = math.clamp(count * 28 + 4, 0, 110)
                    local targetSize = normalHeight + contentH + 8
                    TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, targetSize)}):Play()
                    TweenService:Create(listHolder, TweenInfo.new(0.2), {Size = UDim2.new(1, -16, 0, contentH)}):Play()
                end
            end
            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                if open then
                    updateItems(searchBox.Text)
                end
            end)
            searchBox.Focused:Connect(function()
                open = true
                arrowBtn.Text = "▲"
                updateItems(searchBox.Text)
            end)
            arrowBtn.MouseButton1Click:Connect(function()
                open = not open
                arrowBtn.Text = open and "▲" or "▼"
                if open then
                    updateItems(searchBox.Text)
                else
                    TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, normalHeight)}):Play()
                    TweenService:Create(listHolder, TweenInfo.new(0.2), {Size = UDim2.new(1, -16, 0, 0)}):Play()
                end
            end)
        end
        return TabObj
    end
    if CurrentTheme ~= "Dark Gray" then
        ApplyTheme()
    end
    return WindowObj
