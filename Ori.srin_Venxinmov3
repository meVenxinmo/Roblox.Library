    local function SameColor(a, b)
        return a and b
            and math.abs(a.R - b.R) < 0.01
            and math.abs(a.G - b.G) < 0.01
            and math.abs(a.B - b.B) < 0.01
    end
    local function SetThemeRole(object, role)
        if object and object.SetAttribute then
            object:SetAttribute("ThemeRole", role)
        end
    end
    local function ApplyTheme()
        local t = Themes[CurrentTheme]
        local base = {
            ["18,18,18"] = "Surface", ["24,24,24"] = "Panel", ["26,26,26"] = "Tab",
            ["35,35,35"] = "Button", ["45,45,45"] = "Active", ["50,50,50"] = "Stroke",
            ["60,60,60"] = "Stroke", ["200,200,200"] = "Muted", ["210,210,210"] = "Text",
            ["220,220,220"] = "Text", ["255,255,255"] = "Text"
        }
        for _, object in ipairs(ScreenGui:GetDescendants()) do
            if object:IsA("GuiObject") then
                local role = object:GetAttribute("ThemeRole")
                if not role and object:IsA("Frame") or not role and object:IsA("TextButton") then
                    local c = object.BackgroundColor3
                    local key = string.format("%d,%d,%d", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
                    role = base[key]
                    if role then SetThemeRole(object, role) end
                end
                if role and t[role] then
                    object.BackgroundColor3 = t[role]
                end
                if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                    local textColor = object.TextColor3
                    if SameColor(textColor, Color3.fromRGB(170, 170, 170)) then
                        object.TextColor3 = t.Muted
                    elseif not object:GetAttribute("ThemeTextRole") then
                        object:SetAttribute("ThemeTextRole", "Text")
                        object.TextColor3 = t.Text
                    else
                        object.TextColor3 = t.Text
                    end
                end
            elseif object:IsA("UIStroke") then
                object.Color = t.Stroke
            end
        end
        if MainFrame and MainFrame.Parent then
            MainFrame.BackgroundColor3 = t.Surface
            TopBar.BackgroundColor3 = t.Panel
            MainStroke.Color = t.Stroke
        end
    end
