            local itemHeight = 28
            for _, v in ipairs(list or {}) do
                local itemBtn = Instance.new("TextButton", listHolder)
                itemBtn.Size = UDim2.new(1, 0, 0, itemHeight)
                itemBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
