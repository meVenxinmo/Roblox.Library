        function TabObj:AddSlider(text, min, max, default, callback)
            min = min or 0
            max = max or 100
            default = default == nil and min or default
            if max <= min then
                max = min + 1
            end
            local frame = Instance.new("Frame", scrollingFrame)
            frame.Size = UDim2.new(1, 0, 0, 58)
            frame.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
            frame.BorderSizePixel = 0
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
            local label = Instance.new("TextLabel", frame)
            label.Size = UDim2.new(0.62, -10, 0, 22)
            label.Position = UDim2.new(0, 10, 0, 5)
            label.BackgroundTransparency = 1
            label.Text = text
            label.TextColor3 = Color3.fromRGB(205, 205, 205)
            label.TextSize = 12
            label.Font = Enum.Font.Gotham
            label.TextXAlignment = Enum.TextXAlignment.Left
            local valueLabel = Instance.new("TextLabel", frame)
            valueLabel.Size = UDim2.new(0.2, 0, 0, 22)
            valueLabel.Position = UDim2.new(0.62, 0, 0, 5)
            valueLabel.BackgroundTransparency = 1
            valueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            valueLabel.TextSize = 12
            valueLabel.Font = Enum.Font.GothamBold
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            local percentLabel = Instance.new("TextLabel", frame)
            percentLabel.Size = UDim2.new(0.18, -10, 0, 22)
            percentLabel.Position = UDim2.new(0.82, 0, 0, 5)
            percentLabel.BackgroundTransparency = 1
            percentLabel.TextColor3 = Color3.fromRGB(100, 190, 255)
            percentLabel.TextSize = 12
            percentLabel.Font = Enum.Font.GothamBold
            percentLabel.TextXAlignment = Enum.TextXAlignment.Right
            local sliderBar = Instance.new("Frame", frame)
            sliderBar.Size = UDim2.new(1, -20, 0, 7)
            sliderBar.Position = UDim2.new(0, 10, 0, 38)
            sliderBar.BackgroundColor3 = Color3.fromRGB(45, 47, 54)
            sliderBar.BorderSizePixel = 0
            sliderBar.Active = true
            Instance.new("UICorner", sliderBar).CornerRadius = UDim.new(1, 0)
            local sliderFill = Instance.new("Frame", sliderBar)
            sliderFill.Size = UDim2.new(0, 0, 1, 0)
            sliderFill.BackgroundColor3 = Color3.fromRGB(65, 170, 255)
            sliderFill.BorderSizePixel = 0
            Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)
            local sliderButton = Instance.new("TextButton", sliderBar)
            sliderButton.Size = UDim2.new(0, 30, 0, 30)
            sliderButton.Position = UDim2.new(0, -15, 0.5, -15)
            sliderButton.BackgroundTransparency = 1
            sliderButton.Text = ""
            sliderButton.AutoButtonColor = false
            sliderButton.ZIndex = 4
            local visualKnob = Instance.new("Frame", sliderButton)
            visualKnob.Size = UDim2.new(0, 16, 0, 16)
            visualKnob.Position = UDim2.new(0.5, -8, 0.5, -8)
            visualKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            visualKnob.BorderSizePixel = 0
            visualKnob.ZIndex = 5
            Instance.new("UICorner", visualKnob).CornerRadius = UDim.new(1, 0)
            local knobStroke = Instance.new("UIStroke", visualKnob)
            knobStroke.Color = Color3.fromRGB(65, 170, 255)
            knobStroke.Thickness = 2
            local value = math.clamp(default, min, max)
            local draggingSlider = false
            local activeInput = nil
            local lastCallbackValue = nil
            local function renderValue(pos, fireCallback)
                pos = math.clamp(pos, 0, 1)
                value = min + ((max - min) * pos)
                local roundedValue = math.floor(value + 0.5)
                local shownPercent = math.floor((pos * 100) + 0.5)
                sliderFill.Size = UDim2.new(pos, 0, 1, 0)
                sliderButton.Position = UDim2.new(pos, -15, 0.5, -15)
                valueLabel.Text = tostring(roundedValue)
                percentLabel.Text = tostring(shownPercent) .. "%"
                if fireCallback and roundedValue ~= lastCallbackValue then
                    lastCallbackValue = roundedValue
                    pcall(function()
                        callback(roundedValue)
                    end)
                end
            end
            local function updateFromInput(input, fireCallback)
                if not input or sliderBar.AbsoluteSize.X <= 0 then
                    return
                end
                local x = input.Position.X
                local pos = (x - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X
                renderValue(pos, fireCallback)
            end
            renderValue((value - min) / (max - min), false)
            local function beginDrag(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = true
                    activeInput = input
                    visualKnob.BackgroundColor3 = Color3.fromRGB(220, 245, 255)
                    updateFromInput(input, true)
                end
            end
            sliderButton.InputBegan:Connect(beginDrag)
            sliderBar.InputBegan:Connect(beginDrag)
            UserInputService.InputChanged:Connect(function(input)
                if not draggingSlider then
                    return
                end
                if activeInput and activeInput.UserInputType == Enum.UserInputType.Touch then
                    if input == activeInput then
                        updateFromInput(input, true)
                    end
                elseif input.UserInputType == Enum.UserInputType.MouseMovement then
                    updateFromInput(input, true)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                local isPointer = input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch
                if isPointer and (activeInput == input or input.UserInputType == Enum.UserInputType.MouseButton1) then
                    draggingSlider = false
                    activeInput = nil
                    visualKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                end
            end)
            UserInputService.WindowFocusReleased:Connect(function()
                draggingSlider = false
                activeInput = nil
                visualKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            end)
        end
        function TabObj:AddDropdown(text, list, callback)
            local frame = Instance.new("Frame", scrollingFrame)
