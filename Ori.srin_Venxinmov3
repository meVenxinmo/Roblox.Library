                Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 4)
                itemBtn.MouseButton1Click:Connect(function()
                    label.Text = text .. ": " .. tostring(v)
                    open = false
                    TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, normalHeight)}):Play()
                    TweenService:Create(listHolder, TweenInfo.new(0.2), {Size = UDim2.new(1, -16, 0, 0)}):Play()
                    arrow.Text = "▼"
                    pcall(function() callback(v) end)
                end)
            end
            listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                listHolder.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
            end)
            local dropBtn = Instance.new("TextButton", frame)
            dropBtn.Size = UDim2.new(1, 0, 0, 36)
            dropBtn.BackgroundTransparency = 1
            dropBtn.Text = ""
            dropBtn.MouseButton1Click:Connect(function()
                open = not open
                local contentH = math.clamp(#list * (itemHeight + 4) + 8, 0, 120)
                local targetSize = open and (normalHeight + contentH + 6) or normalHeight
                TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, targetSize)}):Play()
                TweenService:Create(listHolder, TweenInfo.new(0.2), {Size = UDim2.new(1, -16, 0, open and contentH or 0)}):Play()
                arrow.Text = open and "▲" or "▼"
            end)
        end
